@echo off
cd /d "%~dp0"
git add -A
if "%~1"=="" (
    git commit -m "Структуры (struct): объявление типа, глобальные/локальные переменные, доступ через точку (в т.ч. цепочкой), инициализатор при объявлении, присваивание целиком (a=b), поля-массивы и вложенные структуры; правки Lexer/Parser/AST/CodeGen; справка обновлена; интерфейс редактора уровней и подсказки в главном окне"
) else (
    git commit -m "%~1"
)
git push origin main
pause
